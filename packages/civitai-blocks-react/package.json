{
  "name": "@civitai/blocks-react",
  "version": "0.42.0",
  "description": "React hooks and iframe transport for Civitai Apps. Pairs with @civitai/app-sdk/blocks.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/index.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@civitai/components": "workspace:*",
    "@civitai/theme": "workspace:*"
  },
  "peerDependencies": {
    "@civitai/app-sdk": ">=0.29.0 <1.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@civitai/app-sdk": "workspace:^",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@vitest/browser": "4.1.7",
    "@vitest/browser-playwright": "4.1.7",
    "happy-dom": "^20.9.0",
    "playwright": "^1.62.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "civitai",
    "blocks",
    "react",
    "iframe",
    "postmessage",
    "embed"
  ],
  "homepage": "https://github.com/civitai/civitai-app-starters/tree/main/packages/civitai-blocks-react#readme",
  "bugs": "https://github.com/civitai/civitai-app-starters/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/civitai/civitai-app-starters.git",
    "directory": "packages/civitai-blocks-react"
  }
}
