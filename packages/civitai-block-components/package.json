{
  "name": "@civitai/block-components",
  "version": "0.1.0",
  "description": "Custom elements that speak the Civitai App host bridge \u2014 @civitai/components with @civitai/blocks-client behind them.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.define.js",
    "**/elements/register.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/elements/register.d.ts",
      "import": "./dist/elements/register.js"
    },
    "./civitai-sign-in-button": {
      "types": "./dist/elements/civitai-sign-in-button.d.ts",
      "import": "./dist/elements/civitai-sign-in-button.js"
    },
    "./civitai-sign-in-button/define": {
      "types": "./dist/elements/civitai-sign-in-button.define.d.ts",
      "import": "./dist/elements/civitai-sign-in-button.define.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:layering": "node scripts/check-layering.mjs",
    "test": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest --project node"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@civitai/blocks-client": "workspace:*",
    "@civitai/components": "workspace:*",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitest/browser-playwright": "^4.1.11",
    "playwright": "^1.50.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "civitai",
    "blocks",
    "custom-elements",
    "web-components",
    "design-system"
  ],
  "homepage": "https://github.com/civitai/civitai-app-starters/tree/main/packages/civitai-block-components#readme",
  "bugs": "https://github.com/civitai/civitai-app-starters/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/civitai/civitai-app-starters.git",
    "directory": "packages/civitai-block-components"
  }
}
