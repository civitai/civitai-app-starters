{
  "$schema": "https://civitai.com/schemas/app-block/v1.json",
  "blockId": "buzz-purchase-demo",
  "version": "0.1.0",
  "name": "Buzz Purchase Demo",
  "type": "block",
  "targets": [
    {
      "slotId": "model.sidebar_top",
      "priority": 100,
      "requiredContext": ["modelId", "modelVersionId"]
    }
  ],
  "scopes": ["models:read:self", "ai:write:budgeted"],
  "scopeJustifications": {
    "ai:write:budgeted": "Runs a text-to-image generation on this model for the viewer, spending the viewer's Buzz within the per-generation budget; when they cannot afford it, offers a Buzz top-up and retries."
  },
  "iframe": {
    "minHeight": 300,
    "maxHeight": 700,
    "resizable": true,
    "sandbox": "allow-scripts allow-forms"
  },
  "contentRating": "pg",
  "minApiVersion": "1.0",
  "buildCommand": "npm run build",
  "outputDir": "dist"
}
