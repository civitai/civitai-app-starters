{
  "$schema": "https://civitai.com/schemas/app-block/v1.json",
  "blockId": "generation-kinds-demo",
  "version": "0.1.0",
  "name": "Generation Kinds Demo",
  "type": "block",
  "scopes": ["ai:write:budgeted"],
  "scopeJustifications": {
    "ai:write:budgeted": "Runs a registered Comfy recipe and a chat-completion step for the viewer, spending the viewer's Buzz up to this page's per-generation budget."
  },
  "page": {
    "path": "/",
    "title": "Generation Kinds Demo",
    "icon": "bolt",
    "buzzBudgetPerGen": 300
  },
  "bootSkeleton": true,
  "iframe": {
    "minHeight": 600,
    "maxHeight": 4000,
    "resizable": true,
    "sandbox": "allow-scripts allow-forms"
  },
  "contentRating": "g",
  "minApiVersion": "1.0",
  "buildCommand": "npm run build",
  "outputDir": "dist"
}
