# Comma-separated list of allowed parent-frame origins. The IframeTransport
# drops every postMessage whose `event.origin` isn't in this list, and refuses
# to mount with an empty list.
#
# Production: platform-injected at build time (an ENV that Vite prioritizes over
# .env files), so the value here only matters for a local `npm run dev`. The
# authoritative prod set:
#   VITE_BLOCK_ALLOWED_PARENT_ORIGINS=https://civitai.com,https://*.civitai.com,https://*.civitaic.com,https://civitai.red,https://*.civitai.red
#
# `dev:harness` and `dev:live` do NOT read it: src/Harness.tsx allowlists the
# dev server's own origin before anything else runs.
VITE_BLOCK_ALLOWED_PARENT_ORIGINS=http://localhost:5189

# "true" mounts the dev host (src/Harness.tsx). `dev:harness` / `dev:live` set
# it for you. NEVER set it in a production build.
VITE_DEV_HARNESS=

# "true" swaps the MOCK host for the LIVE one (`npm run dev:live`): your local
# block against the REAL Civitai backend. ⚠️ A real generation spends YOUR OWN
# real Buzz; the token's per-generation budget and your daily cap bound it.
VITE_LIVE_MODE=

# LIVE only: a short-lived dev block token, minted for an app you submitted:
#   civitai app dev-token <your-app-slug> --env >> .env.development.local
# ⚠️ Put the real value in the git-ignored `.env.development.local`, NEVER here:
# `civitai app submit` uploads this file, and every VITE_ var is bundled into
# client JS. Never put an API key in a VITE_ var.
VITE_LIVE_BLOCK_TOKEN=

# LIVE only: where vite.config.ts proxies `/api` (default https://civitai.com).
VITE_LIVE_HOST_ORIGIN=
