# Comma-separated list of allowed parent-frame origins. The IframeTransport
# drops every postMessage whose `event.origin` isn't in this list. REQUIRED —
# without it the transport refuses to mount (gotcha #53).
#
# Production: the host page origin(s) embedding the block:
#   VITE_BLOCK_ALLOWED_PARENT_ORIGINS=https://civitai.com,https://www.civitai.com
#
# Local harness: the dev-server origin. `pnpm dev:harness` serves on
# localhost:5180, so pin exactly that:
VITE_BLOCK_ALLOWED_PARENT_ORIGINS=http://localhost:5180

# Set to "true" to mount the dev Harness. `pnpm dev:harness` flips this on.
VITE_DEV_HARNESS=
