{
  "$schema": "https://civitai.com/schemas/app-block/v1.json",
  "appId": "app_REPLACE_ME",
  "blockId": "buzz-workflow-demo",
  "version": "0.1.0",
  "name": "Buzz Workflow Demo",
  "type": "block",
  "targets": [
    {
      "slotId": "model.sidebar_top",
      "priority": 100,
      "requiredContext": ["modelId", "modelVersionId"]
    }
  ],
  "scopes": ["models:read:self", "ai:write:budgeted"],
  "settings": {
    "max_buzz_per_generation": {
      "scope": "publisher",
      "type": "number",
      "widget": "number",
      "label": "Max Buzz per generation",
      "description": "Hard ceiling the host enforces on each generation's cost.",
      "default": 500,
      "min": 0,
      "max": 1000,
      "requires_scope": "ai:write:budgeted"
    }
  },
  "iframe": {
    "minHeight": 400,
    "maxHeight": 1200,
    "resizable": true,
    "sandbox": "allow-scripts allow-forms"
  },
  "contentRating": "pg",
  "minApiVersion": "1.0"
}
