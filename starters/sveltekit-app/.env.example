# --- Civitai OAuth App ----------------------------------------------------
# Create at https://civitai.com/user/account → OAuth Apps.
#   Client type:  Confidential (server-side app) — this starter holds the secret.
#   Grants:       authorization_code, refresh_token
#   Redirect URI: ${APP_URL}/api/auth/callback/civitai
#
# Scopes the OAuth App must grant (must match REQUESTED_SCOPES in src/lib/scopes.ts):
#   UserRead         — read profile + Buzz balance
#   BuzzRead         — show balance and cost preview
#   AIServicesRead   — read generation history
#   AIServicesWrite  — submit a generation (implicitly debits the user's Buzz)
#
# To add more scopes: extend REQUESTED_SCOPES in src/lib/scopes.ts (see
# `/add-oauth-scope` slash command) AND grant them on the OAuth App page.
# Existing sessions need to log out + back in to re-consent.
CIVITAI_CLIENT_ID=
CIVITAI_CLIENT_SECRET=

# Long, random hex string used to seal session cookies (AES-256-GCM via @civitai/app-sdk).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public base URL of this app. Used to build the OAuth redirect URI.
APP_URL=http://localhost:5173

# Auth hub URL. OAuth endpoints (authorize / token / revoke) live here.
# For local dev against a local auth hub, set this to e.g. http://localhost:3099.
CIVITAI_AUTH_URL=https://auth.civitai.com

# Main app URL. Used ONLY for /api/v1/me and tRPC/buzz calls (NOT oauth).
# Override for dev (e.g. http://localhost:3000).
CIVITAI_BASE_URL=https://civitai.com

# Orchestrator base URL. Leave default in production.
ORCHESTRATOR_URL=https://orchestration.civitai.com

# Uncomment if your Civitai dev host uses a self-signed cert. Disables Node TLS
# verification for the whole process — dev only, never in production.
# NODE_TLS_REJECT_UNAUTHORIZED=0
