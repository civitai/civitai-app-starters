{
  "name": "civitai-sveltekit-app-starter",
  "version": "0.0.0",
  "private": true,
  "description": "SvelteKit 2 starter for building Civitai OAuth + Buzz-powered apps.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "civitai",
    "oauth",
    "pkce",
    "starter",
    "template",
    "sveltekit",
    "svelte",
    "ai",
    "generation"
  ],
  "homepage": "https://github.com/civitai/civitai-app-starters/tree/main/starters/sveltekit-app#readme",
  "bugs": "https://github.com/civitai/civitai-app-starters/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/civitai/civitai-app-starters.git",
    "directory": "starters/sveltekit-app"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:env": "node scripts/check-env.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@civitai/app-sdk": "^0.26.0",
    "@civitai/components": "workspace:^",
    "@civitai/theme": "workspace:^",
    "@t3-oss/env-core": "^0.13.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.61.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.4",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^25.9.1",
    "svelte": "^5.55.10",
    "svelte-check": "^4.4.0",
    "tailwindcss": "^4.3.0",
    "tslib": "^2.6.2",
    "typescript": "^5.9.2",
    "vite": "^8.0.14"
  }
}
