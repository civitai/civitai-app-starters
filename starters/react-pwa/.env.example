# Civitai OAuth App credentials. Create at https://civitai.com/user/account → OAuth Apps.
# Client type: "Confidential (server-side app)" — the BFF holds the secret.
# Redirect URI: ${APP_URL}/api/auth/callback/civitai
CIVITAI_CLIENT_ID=
CIVITAI_CLIENT_SECRET=

# Random hex string used to seal session cookies (AES-256-GCM via @civitai/app-sdk).
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public base URL of this app. Used to build the OAuth redirect URI.
APP_URL=http://localhost:5174

# Civitai base URL. Override for dev (e.g. http://localhost:3000).
CIVITAI_BASE_URL=https://civitai.com

# Orchestrator base URL. Leave default in production.
ORCHESTRATOR_URL=https://orchestration.civitai.com

# Port the production server (pnpm start) listens on. Vite dev server uses
# its own port (5174 by default).
PORT=5174

# Uncomment if your Civitai dev host uses a self-signed cert. Disables Node TLS
# verification for the whole process — dev only, never in production.
# NODE_TLS_REJECT_UNAUTHORIZED=0
