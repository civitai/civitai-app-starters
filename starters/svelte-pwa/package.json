{
  "name": "civitai-svelte-pwa-starter",
  "version": "0.0.0",
  "private": true,
  "description": "Vite + Svelte 5 (no Kit) PWA starter (with Hono BFF) for building Civitai OAuth + Buzz-powered apps.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "civitai",
    "oauth",
    "pkce",
    "starter",
    "template",
    "vite",
    "svelte",
    "pwa",
    "hono",
    "bff",
    "ai",
    "generation"
  ],
  "homepage": "https://github.com/civitai/civitai-app-starters/tree/main/starters/svelte-pwa#readme",
  "bugs": "https://github.com/civitai/civitai-app-starters/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/civitai/civitai-app-starters.git",
    "directory": "starters/svelte-pwa"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file=.env dist-server/index.js",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.server.json --noEmit",
    "check:env": "node scripts/check-env.mjs",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@civitai/app-sdk": "^0.1.0",
    "@hono/node-server": "^1.13.0",
    "@t3-oss/env-core": "^0.13.0",
    "hono": "^4.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^0.18.0",
    "@playwright/test": "^1.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.4",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^25.9.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "svelte": "^5.50.0",
    "svelte-check": "^4.4.0",
    "tailwindcss": "^3.4.17",
    "tslib": "^2.6.2",
    "typescript": "^5.9.2",
    "vite": "^7.2.0",
    "vite-plugin-pwa": "^1.1.0"
  }
}
