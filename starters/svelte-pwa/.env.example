# Civitai OAuth App credentials. Create at https://civitai.com/user/account → OAuth Apps.
# Client type: "Confidential (server-side app)" — BFF holds the secret.
# Redirect URI: ${APP_URL}/api/auth/callback/civitai
CIVITAI_CLIENT_ID=
CIVITAI_CLIENT_SECRET=

# Random hex for sealing session cookies (AES-256-GCM via @civitai/app-sdk).
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public base URL of this app.
APP_URL=http://localhost:5175

# Civitai base URL.
CIVITAI_BASE_URL=https://civitai.com

# Orchestrator base URL.
ORCHESTRATOR_URL=https://orchestration.civitai.com

# Production server (pnpm start) port.
PORT=5175

# Uncomment if your Civitai dev host uses a self-signed cert. Disables Node TLS
# verification for the whole process — dev only, never in production.
# NODE_TLS_REJECT_UNAUTHORIZED=0
