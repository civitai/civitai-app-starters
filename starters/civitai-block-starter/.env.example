# Comma-separated list of allowed parent-frame origins. The IframeTransport
# drops every postMessage whose `event.origin` isn't in this list. MUST contain
# at least one entry — block apps without an allowlist fail to mount.
#
# In production, this value is platform-injected at build time by the App Blocks
# build recipe (it sets an ENV that Vite prioritizes over .env files), so the
# value committed here only matters for LOCAL DEV. The authoritative prod set:
# `https://civitai.com,https://*.civitai.com,https://*.civitaic.com,https://civitai.red,https://*.civitai.red`.
#
# In local development with the harness, set to the dev server origin:
VITE_BLOCK_ALLOWED_PARENT_ORIGINS=http://localhost:5173

# Set to "true" to mount the dev Harness (simulates BLOCK_INIT locally without
# civitai.com embedding the block). `pnpm dev:harness` flips this on for you.
VITE_DEV_HARNESS=

# ─────────────────────────────────────────────────────────────────────────────
# LIVE mode (`pnpm dev:live`) — run local block code against the REAL backend.
# ─────────────────────────────────────────────────────────────────────────────
# Set to "true" (alongside VITE_DEV_HARNESS=true) to mount the LIVE harness,
# which forwards the App-Block postMessage protocol to the REAL Civitai backend
# instead of mocking it. `pnpm dev:live` flips both on for you.
#
# ⚠️ REAL MONEY: a successful generation in live mode SPENDS YOUR OWN real Buzz
# against real compute. The dev token's per-call budget + the per-user daily cap
# bound it server-side, but this is NOT a sandbox. Use `pnpm dev:harness` (mock
# mode) for pure UI iteration.
VITE_LIVE_MODE=

# The DEV BLOCK TOKEN — a SHORT-LIVED (~15min) RS256 JWT you mint via:
#   POST /api/v1/blocks/dev-token
#   Authorization: Bearer <your personal Civitai API key>
#   { "appBlockId": "<an approved app you own>" }   (or { "slug": "<blockId>" })
# (mod-gated, pre-GA). Paste the returned `token` here; re-mint + restart when
# it expires (the live host logs an actionable error + the backend 401s).
#
# ⚠️ SECURITY (scope doc §5.1): every `VITE_`-prefixed var is BUNDLED into the
# client JS. ONLY ever put a SHORT-LIVED pasted TOKEN here — NEVER an API key
# (an API key in a VITE_ var would be exposed in the dev bundle). A dev-proxy
# that holds the API key server-side and auto-mints is a future follow-up.
VITE_LIVE_BLOCK_TOKEN=

# Optional: point live mode at a non-prod backend (e.g. a staging host). When
# omitted, the live host forwards to https://civitai.com.
VITE_LIVE_BACKEND_URL=
