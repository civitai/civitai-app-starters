# Comma-separated list of allowed parent-frame origins. The bridge drops every
# postMessage whose `event.origin` isn't in this list.
#
# In production, this value is platform-injected at build time by the App Blocks
# build recipe (it sets an ENV that Vite prioritizes over .env files), so the
# value committed here only matters for LOCAL DEV. Left unset, @civitai/sdk falls
# back to the canonical civitai.com origins — which is why the dev harness, whose
# fake host posts from the dev server's own origin, needs this set:
VITE_BLOCK_ALLOWED_PARENT_ORIGINS=http://localhost:5173

# Set to "true" to install the dev harness (simulates BLOCK_INIT locally without
# civitai.com embedding the block). `npm run dev:harness` flips this on for you.
VITE_DEV_HARNESS=
